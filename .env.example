# Copy to .env and edit. Every setting is optional.
HOST=127.0.0.1
PORT=5000
COOKIE_SECURE=false             # set true when served over HTTPS
# SECRET_KEY=change-me          # auto-generated into data/.secret_key when omitted

# Storage
DATA_DIR=./data
RETENTION_HOURS=24              # how long converted files stay downloadable
MIN_FREE_GB=1                   # refuse work when less free disk than this would remain
DELETE_SOURCE_AFTER_SUCCESS=true

# Limits
MAX_UPLOAD_GB=5
CHUNK_MB=8
MAX_CONCURRENT_JOBS=1
MAX_QUEUE_LENGTH=20
MAX_JOBS_PER_OWNER=2
JOB_TIMEOUT_SECONDS=21600

# FFmpeg (leave as-is when they are on PATH)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Optional AI enhancement (Real-ESRGAN ncnn-vulkan). Example for Windows:
# REALESRGAN_BIN=C:\tools\realesrgan-ncnn-vulkan\realesrgan-ncnn-vulkan.exe
# REALESRGAN_MODELS_DIR=C:\tools\realesrgan-ncnn-vulkan\models
REALESRGAN_MODEL=realesr-animevideov3
# REALESRGAN_GPU_ID=0
AI_MAX_FRAMES=30000
